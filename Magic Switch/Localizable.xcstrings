          "stringUnit" : {
            "state" : "translated",
            "value" : "El otro Mac aún no está listo para añadirse. Prueba de nuevo en un momento."
          }
        }
      }
    },
    "The other Mac returned an invalid response." : {
      "localizations" : {
        "es" : {

            "state" : "translated",
            "value" : "El otro Mac devolvió una respuesta no válida."
          }
        }
      }
    },
    "The other Mac runs an older version of Magic Switch that can't be added by address. Update it first." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El otro Mac ejecuta una versión anterior de Magic Switch que no se puede añadir por dirección. Actualízalo primero."
          }
        }

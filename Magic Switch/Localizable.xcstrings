    "Identity Mismatch Resolved" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discrepancia de identidad resuelta"
          }
        }
      }
    },
    "If your network won't let the Macs reach each other at all, turn on Connect over Bluetooth in Settings → Other." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu red no deja que los Macs se vean entre sí, activa Conectar por Bluetooth cuando la red no pueda en Ajustes → Otros."
          }
        }
      }
    },
    "Invalid Switch Command" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comando de cambio no válido"
          }
        }
      }
    },
    "Invalid code." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Código no válido."
          }
        }
      }
    },
    "Invalid direction '%@'. Use 'take', 'send', or 'toggle'." : {
      "comment" : "Keep 'take', 'send' and 'toggle' as is; they are literal URL parameter values",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dirección '%@' no válida. Usa 'take', 'send' o 'toggle'."
          }
        }
      }
    },
    "It will be removed from Magic Switch's list. Its Bluetooth pairing is not affected. You can add it again from Available Peripherals while it's paired with this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará de la lista de Magic Switch. Su emparejamiento Bluetooth no se ve afectado. Puedes volver a añadirlo desde Periféricos disponibles mientras esté emparejado con este Mac."
          }
        }
      }
    },
    "It will no longer be your other Mac. You can add it again from \"Macs Found on the Network\"." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejará de ser tu otro Mac. Puedes volver a añadirlo desde «Macs encontrados en la red»."
          }
        }
      }
    },
    "Keep trying for up to 10 minutes to reconnect a peripheral that dropped from this Mac, and take over the ones your other Mac leaves behind when it sleeps. Never takes a peripheral your other Mac is using." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue intentando durante hasta 10 minutos reconectar un periférico que se ha desconectado de este Mac, y se queda con los que tu otro Mac deja atrás cuando entra en reposo. Nunca toma un periférico que tu otro Mac esté usando."
          }
        }
      }
    },
    "Kept %@ on this Mac. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kept %1$@ on this Mac. %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha mantenido %1$@ en este Mac. %2$@"
          }
        }
      }
    },
    "Key %lld" : {
      "comment" : "Shown in a keyboard shortcut for a key with no character; %lld is its key code",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tecla %lld"
          }
        }
      }
    },
    "Keyboard" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teclado"
          }
        }
      }
    },
    "Keyboard Shortcuts" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atajos de teclado"
          }
        }
      }
    },
    "License Information" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Información de licencia"
          }
        }
      }
    },
    "Link this Mac to your other Mac. Separate from Bluetooth pairing in System Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincula este Mac con tu otro Mac. Es independiente del emparejamiento Bluetooth en Ajustes del Sistema."
          }
        }
      }
    },
    "Macs" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macs"
          }
        }
      }
    },
    "Macs Found on the Network" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macs encontrados en la red"
          }
        }
      }
    },
    "Magic Switch can't switch peripherals while Bluetooth is off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Switch no puede cambiar los periféricos mientras Bluetooth está desactivado."
          }
        }
      }
    },
    "Magic Switch couldn't find %@. Remove it and add it again from Available Peripherals." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Switch no pudo encontrar %@. Elimínalo y vuelve a añadirlo desde Periféricos disponibles."
          }
        }
      }
    },
    "Magic Switch couldn't release %@ from this Mac. Try Forget This Device in System Settings → Bluetooth." : {
      "comment" : "Forget This Device and System Settings → Bluetooth are macOS UI names",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Switch no pudo liberar %@ de este Mac. Prueba «Olvidar este dispositivo» en Ajustes del Sistema → Bluetooth."
          }
        }
      }
    },
    "Magic Switch isn't allowed to use Bluetooth. Allow it in System Settings → Privacy & Security → Bluetooth." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Switch no tiene permiso para usar Bluetooth. Concédelo en Ajustes del Sistema → Privacidad y seguridad → Bluetooth."
          }
        }
      }
    },
    "Magic Switch needs attention" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Switch necesita tu atención"
          }
        }
      }
    },
    "Magic Switch reset this Mac's pairing for %@ and couldn't pair it again. Turn %@ off and on — if it doesn't come back, pair it again in System Settings → Bluetooth." : {
      "comment" : "System Settings → Bluetooth is a macOS UI name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Magic Switch reset this Mac's pairing for %1$@ and couldn't pair it again. Turn %2$@ off and on — if it doesn't come back, pair it again in System Settings → Bluetooth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Switch restableció el emparejamiento de este Mac con %1$@ y no pudo volver a emparejarlo. Apaga y enciende %2$@; si no vuelve, empareja de nuevo en Ajustes del Sistema → Bluetooth."
          }
        }
      }
    },
    "Magic Switch stopped trying to connect %@ after %lld minutes. Switch it off and on, then click it in the menu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Magic Switch stopped trying to connect %1$@ after %2$lld minutes. Switch it off and on, then click it in the menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

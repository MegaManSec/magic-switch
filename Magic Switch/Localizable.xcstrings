        }
      }
    },
    "Couldn't establish a secure connection. Make sure your other Mac is paired with the same code (Settings → Pairing)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo establecer una conexión segura. Asegúrate de que tu otro Mac está emparejado con el mismo código (Ajustes → Emparejamiento)."
          }
        }
      }
    },
    "Couldn't pair %@ in time. It may be off, out of range, or connected to your other Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo emparejar %@ a tiempo. Puede estar apagado, fuera de alcance o conectado a tu otro Mac."
          }
        }
      }
    },
    "Couldn't pair %@. Turn it off and on, then try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo emparejar %@. Apágalo y vuelve a encenderlo, y prueba de nuevo."

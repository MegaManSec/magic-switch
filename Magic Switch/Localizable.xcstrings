    },
    "External Display" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantalla externa"
          }
        }
      }
    },
    "For networks that block Bonjour. Pair both Macs with the same code first, then enter the other Mac's IP address." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para redes que bloquean Bonjour. Primero empareja ambos Macs con el mismo código y después introduce la dirección IP del otro Mac."
          }
        }
      }
    },

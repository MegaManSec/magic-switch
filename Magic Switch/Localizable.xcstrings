{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@" : {
      "comment" : "Two sentences: the Bonjour advisory, then the add-by-address instruction",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ (%@)" : {
      "comment" : "An IP address followed by the name of its network, e.g. 192.168.1.5 (Wi-Fi)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ Magic Switch keeps trying for up to %lld minutes." : {
      "comment" : "Appended to a failure body while the reconnect watcher still retries; %1$@ is the failure sentence, %2$lld the retry window in minutes",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Magic Switch keeps trying for up to %2$lld minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Magic Switch seguirá intentándolo hasta %2$lld minutos."
          }
        }
      }
    },
    "%@ Reconnecting your peripherals to this Mac." : {
      "comment" : "%@ is a whole sentence saying why the switch failed",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Volviendo a conectar tus periféricos a este Mac."
          }
        }
      }
    },
    "%@ connected — switching your peripherals to this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexión detectada (%@): pasando tus periféricos a este Mac."
          }
        }
      }
    },
    "%@ didn't disconnect from this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se desconectó de este Mac."
          }
        }
      }
    },
    "%@ didn't release %@. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ didn't release %2$@. %3$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no ha liberado %2$@. %3$@"
          }
        }
      }
    },
    "%@ has a new pairing key. If you re-paired the other Mac yourself, open Settings → Macs and choose Trust." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene una nueva clave de emparejamiento. Si has vuelto a emparejar el otro Mac tú mismo, abre Ajustes → Macs y elige Confiar."
          }
        }
      }
    },
    "%@ has a new pairing key. Switching is paused until you choose Trust in Settings → Macs." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene una nueva clave de emparejamiento. El cambio queda en pausa hasta que elijas Confiar en Ajustes → Macs."
          }
        }
      }
    },
    "%@ has a new pairing key. Switching is paused until you choose Trust, or until %@ proves it has this Mac's current key." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has a new pairing key. Switching is paused until you choose Trust, or until %2$@ proves it has this Mac's current key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tiene una nueva clave de emparejamiento. El cambio queda en pausa hasta que elijas Confiar, o hasta que %2$@ demuestre que tiene la clave actual de este Mac."
          }
        }
      }
    },
    "%@ has a pairing key that doesn't match the one seen earlier, so it can't be added. Click the ↻ button to re-scan." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene una clave de emparejamiento que no coincide con la vista anteriormente, así que no se puede añadir. Pulsa el botón ↻ para volver a buscar."
          }
        }
      }
    },
    "%@ is answering at %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is answering at %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ responde en %@."
          }
        }
      }
    },
    "%@ is answering over Bluetooth." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está respondiendo por Bluetooth."
          }
        }
      }
    },
    "%@ is no longer visible on the network." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no es visible en la red."
          }
        }
      }
    },
    "%@ is now called %@, so its entry in Settings → Macs was updated. If you didn't rename that Mac, check which Mac is listed there." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is now called %2$@, so its entry in Settings → Macs was updated. If you didn't rename that Mac, check which Mac is listed there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ahora se llama %2$@, así que se ha actualizado su entrada en Ajustes → Macs. Si no has cambiado el nombre de ese Mac, comprueba qué Mac aparece ahí."
          }
        }
      }
    },
    "%@ is visible on the network." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es visible en la red."
          }
        }
      }
    },
    "%@ isn't connected right now. It still triggers the switch when it next connects. Display ID: %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ isn't connected right now. It still triggers the switch when it next connects. Display ID: %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está conectada ahora mismo. Seguirá activando el cambio cuando se conecte de nuevo. ID de pantalla: %@."
          }
        }
      }
    },
    "%@ isn't reachable on the network or over Bluetooth right now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está accesible ahora mismo ni por la red ni por Bluetooth."
          }
        }
      }
    },
    "%@ isn't reachable on the network right now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está accesible en la red en este momento."
          }
        }
      }
    },
    "%@ isn't responding. It may be off, out of range, or connected to your other Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no responde. Puede estar apagado, fuera de alcance o conectado a tu otro Mac."
          }
        }
      }
    },
    "%@ or %@" : {
      "comment" : "Two IP addresses the other Mac can try, each with its network name in parentheses",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ or %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ o %2$@"
          }
        }
      }
    },
    "%@ proved it has this Mac's current pairing key, so switching resumed. If you didn't re-pair both Macs yourself, pair them again with a fresh code." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha demostrado que tiene la clave de emparejamiento actual de este Mac, así que se ha reanudado el cambio. Si no has vuelto a emparejar ambos Macs tú mismo, empareja de nuevo con un código nuevo."
          }
        }
      }
    },
    "%@ responded." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha respondido."
          }
        }
      }
    },
    "%@ was found nearby over Bluetooth." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se ha encontrado cerca por Bluetooth."
          }
        }
      }
    },
    "%@, error: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, error: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, error: %2$@"
          }
        }
      }
    },
    "%@, on this Mac" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, en este Mac"
          }
        }
      }
    },
    "%@, on this Mac, battery %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, on this Mac, battery %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, en este Mac, batería %2$@"
          }
        }
      }
    },
    "%@, over Bluetooth" : {
      "comment" : "VoiceOver label for a Mac in the menu that is reached over Bluetooth; %@ is the Mac's name",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, por Bluetooth"
          }
        }
      }
    },
    "%@, pairing" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, emparejando"
          }
        }
      }
    },
    "%@, sending" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, enviando"
          }
        }
      }
    },
    "%@, waiting for the other Mac" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, esperando al otro Mac"
          }
        }
      }
    },
    "'direction' needs a value: 'take', 'send', or 'toggle'." : {
      "comment" : "Keep 'direction', 'take', 'send' and 'toggle' as is; they are literal URL parameter name and values",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'direction' necesita un valor: 'take', 'send' o 'toggle'."
          }
        }
      }
    },
    "'peripheral' needs a value: a type (e.g. 'trackpad'), a name, or a MAC address." : {
      "comment" : "Keep 'peripheral' and 'trackpad' as is; they are a literal URL parameter and value",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'peripheral' necesita un valor: un tipo (p. ej., 'trackpad'), un nombre o una dirección MAC."
          }
        }
      }
    },
    "A newer version of Magic Switch is available. Opens the release page in your browser." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una versión más reciente de Magic Switch. Abre la página de la versión en tu navegador."
          }
        }
      }
    },
    "About" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca de"
          }
        }
      }
    },
    "Accept the new pairing key. Only do this if you intentionally re-paired the other Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acepta la nueva clave de emparejamiento. Hazlo solo si has vuelto a emparejar el otro Mac a propósito."
          }
        }
      }
    },
    "Add" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir"
          }
        }
      }
    },
    "Add %@ as your other Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade %@ como tu otro Mac."
          }
        }
      }
    },
    "Add %@ to list" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir %@ a la lista"
          }
        }
      }
    },
    "Add a Mac by Address" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir un Mac por dirección"
          }
        }
      }
    },
    "Add a Mac by address" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir un Mac por dirección"
          }
        }
      }
    },
    "Add a paired Bluetooth peripheral from \"Available Peripherals\" below to manage it from the menu bar." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un periférico Bluetooth emparejado desde «Periféricos disponibles» (abajo) para gestionarlo desde la barra de menús."
          }
        }
      }
    },
    "Add a peripheral to Magic Switch first." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero añade un periférico a Magic Switch."
          }
        }
      }
    },
    "Add this peripheral to Magic Switch's list." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade este periférico a la lista de Magic Switch."
          }
        }
      }
    },
    "Add your other Mac by IP address — for networks that block Bonjour discovery." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu otro Mac por dirección IP, para redes que bloquean la detección por Bonjour."
          }
        }
      }
    },
    "Add your other Mac from \"Macs Found on the Network\" below to start switching peripherals between them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu otro Mac desde «Macs encontrados en la red» (abajo) para empezar a cambiar periféricos entre ellos."
          }
        }
      }
    },
    "Allow Magic Switch in System Settings → Privacy & Security → Bluetooth." : {
      "comment" : "System Settings → Privacy & Security → Bluetooth is a macOS UI path",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite Magic Switch en Ajustes del Sistema → Privacidad y seguridad → Bluetooth."
          }
        }
      }
    },
    "Asking the other Mac to release %@…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidiendo al otro Mac que libere %@…"
          }
        }
      }
    },
    "Asking the other Mac to release this peripheral…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidiendo al otro Mac que libere este periférico…"
          }
        }
      }
    },
    "Automatic" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático"
          }
        }
      }
    },
    "Available Peripherals" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Periféricos disponibles"
          }
        }
      }
    },
    "Battery level of %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nivel de batería de %@."
          }
        }
      }
    },
    "Best guess from this Mac's active network interfaces. If the other Mac can't connect, check this Mac's address in System Settings → Network." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejor estimación a partir de las interfaces de red activas de este Mac. Si el otro Mac no puede conectar, comprueba la dirección de este Mac en Ajustes del Sistema → Red."
          }
        }
      }
    },
    "Bluetooth Off" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth desactivado"
          }
        }
      }
    },
    "Bluetooth Permission Needed" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita permiso de Bluetooth"
          }
        }
      }
    },
    "Bluetooth Unsupported" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth no compatible"
          }
        }
      }
    },
    "Bluetooth is off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth está desactivado."
          }
        }
      }
    },
    "Bluetooth is off. Turn it on in Control Center to reach your other Mac this way." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth está desactivado. Actívalo en el Centro de control para llegar a tu otro Mac de este modo."
          }
        }
      }
    },
    "Bonjour advertising is disabled by policy on this Mac (NoMulticastAdvertisements), so your other Mac can't discover it by itself. An already-added Mac still reaches it automatically; otherwise use the + button on the other Mac to add this one by address." : {
      "comment" : "Keep NoMulticastAdvertisements as is; it is the name of a macOS policy setting",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La publicación de Bonjour está desactivada por una política en este Mac (NoMulticastAdvertisements), así que tu otro Mac no puede descubrirlo por sí solo. Un Mac ya añadido sigue llegando a este automáticamente; si no, usa el botón + en el otro Mac para añadir este por dirección."
          }
        }
      }
    },
    "Can't Switch" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede cambiar"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar"
          }
        }
      }
    },
    "Cancel pairing %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar el emparejamiento de %@"
          }
        }
      }
    },
    "Change shortcut for %@, currently %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Change shortcut for %1$@, currently %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar atajo de %@, actualmente %@"
          }
        }
      }
    },
    "Check GitHub for a newer release right now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca ahora en GitHub una versión más reciente."
          }
        }
      }
    },
    "Check for Updates" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar actualizaciones"
          }
        }
      }
    },
    "Choose which Bluetooth peripherals Magic Switch manages." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué periféricos Bluetooth gestiona Magic Switch."
          }
        }
      }
    },
    "Click to connect %@ to this Mac over Bluetooth." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic para conectar %@ a este Mac por Bluetooth."
          }
        }
      }
    },
    "Click to record a shortcut. Pressing it anywhere in macOS moves the peripherals to whichever Mac doesn't have them, like clicking the other Mac in the menu." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic para grabar un atajo. Al pulsarlo en cualquier parte de macOS, los periféricos pasan al Mac que no los tiene, como al hacer clic en el otro Mac en el menú."
          }
        }
      }
    },
    "Click to record a shortcut. Pressing it anywhere in macOS sends every registered peripheral to the other Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic para grabar un atajo. Al pulsarlo en cualquier parte de macOS, todos los periféricos registrados se envían al otro Mac."
          }
        }
      }
    },
    "Click to record a shortcut. Pressing it anywhere in macOS takes every registered peripheral to this Mac, even while the other Mac is asleep." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic para grabar un atajo. Al pulsarlo en cualquier parte de macOS, todos los periféricos registrados pasan a este Mac, incluso si el otro Mac está en reposo."
          }
        }
      }
    },
    "Click to take %@ to this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic para traer %@ a este Mac."
          }
        }
      }
    },
    "Close" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar"
          }
        }
      }
    },
    "Close without adding." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra sin añadir."
          }
        }
      }
    },
    "Close without pairing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra sin emparejar."
          }
        }
      }
    },
    "Close. Nothing was saved." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra. No se ha guardado nada."
          }
        }
      }
    },
    "Close. The pairing key stays saved on this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra. La clave de emparejamiento se queda guardada en este Mac."
          }
        }
      }
    },
    "Compare with the fingerprint shown on your other Mac — they should match. If they don't, pair both Macs again with the same code." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compárala con la huella que aparece en tu otro Mac: deben coincidir. Si no coinciden, empareja ambos Macs de nuevo con el mismo código."
          }
        }
      }
    },
    "Confirmed: the most recent secure connection between the two Macs used this address." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmada: la conexión segura más reciente entre los dos Macs usó esta dirección."
          }
        }
      }
    },
    "Connect a display to this Mac and it will appear here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta una pantalla a este Mac y aparecerá aquí."
          }
        }
      }
    },
    "Connect over Bluetooth when the network can't" : {
      "comment" : "Toggle label: use Bluetooth to reach the other Mac when the network can't",

    },
    "Couldn't connect." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar."
          }
        }
      }
    },
    "Couldn't disconnect the peripherals from this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron desconectar los periféricos de este Mac."

        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ethernet"
          }
        }
      }
    },
    "Every Bluetooth peripheral paired with this Mac is already added." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los periféricos Bluetooth emparejados con este Mac ya están añadidos."

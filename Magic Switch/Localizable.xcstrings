          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac acepta conexiones en el puerto %@."
          }
        }
      }
    },
    "This Mac couldn't search the network for other Macs. If your other Mac doesn't appear, use the + button to add it by address." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac no pudo buscar otros Macs en la red. Si tu otro Mac no aparece, usa el botón + para añadirlo por dirección."
          }
        }
      }
    },
    "This Mac does not support the Bluetooth features Magic Switch needs." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac no admite las funciones de Bluetooth que necesita Magic Switch."
          }

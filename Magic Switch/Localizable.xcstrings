      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvidar %@"
          }
        }
      }
    },
    "Forget %@ — it will no longer trigger a switch when it connects." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",

    "This Mac isn't accepting connections yet. Try again in a moment." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac aún no acepta conexiones. Prueba de nuevo en un momento."
          }
        }
      }
    },
    "This Mac isn't paired with your other Mac. Open Settings → Pairing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac no está emparejado con tu otro Mac. Abre Ajustes → Emparejamiento."
          }
        }
      }
    },
    "This Mac's Bonjour advertisements aren't reaching the network, so your other Mac can't discover it by itself. An already-added Mac still reaches it automatically; otherwise use the + button on the other Mac to add this one by address." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los anuncios de Bonjour de este Mac no llegan a la red, así que tu otro Mac no puede descubrirlo por sí solo. Un Mac ya añadido sigue llegando a este automáticamente; si no, usa el botón + en el otro Mac para añadir este por dirección."
          }
        }
      }
    },

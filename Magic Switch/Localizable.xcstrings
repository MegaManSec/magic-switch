    "Couldn't connect %@. It may be off, out of range, or connected to your other Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar %@. Puede estar apagado, fuera de alcance o conectado a tu otro Mac."

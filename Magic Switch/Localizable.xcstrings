    "Couldn't reach the other Mac on the network." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo contactar con el otro Mac por la red."
          }
        }
      }
    },
    "Couldn't reach the other Mac securely. Check that it's running Magic Switch and paired with the same code (Settings → Pairing), and that no firewall is blocking the port." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo contactar con el otro Mac de forma segura. Comprueba que ejecuta Magic Switch y que está emparejado con el mismo código (Ajustes → Emparejamiento), y que ningún cortafuegos bloquea el puerto."
          }
        }
      }
    },
    "Couldn't release." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo liberar."
          }
        }

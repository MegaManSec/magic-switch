    "Couldn't start pairing with %@. Turn it off and on, then try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo iniciar el emparejamiento con %@. Apágalo y vuelve a encenderlo, y prueba de nuevo."

      }
    },
    "Couldn't send %@ to %@. Reconnecting it to this Mac." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't send %1$@ to %2$@. Reconnecting it to this Mac."

      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La huella nueva debe coincidir con la que aparece en Ajustes → Emparejamiento en %@."
          }
        }
      }
    },
    "The other Mac couldn't complete the request. If its peripheral list is out of date, click Sync in Settings → Macs." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El otro Mac no pudo completar la solicitud. Si su lista de periféricos está desactualizada, haz clic en Sincronizar en Ajustes → Macs."
          }
        }
      }
    },
    "The other Mac didn't respond in time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El otro Mac no respondió a tiempo."
          }
        }
      }
    },
    "The other Mac isn't ready to be added yet. Try again in a moment." : {
      "localizations" : {

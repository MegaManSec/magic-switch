#!/bin/bash
set -e

# Check every file before formatting so unstaged edits cannot enter the commit.
files=()
while IFS= read -r -d '' file; do
  [[ "$file" == *.swift ]] || continue
  if ! git diff --quiet -- "$file"; then
    printf 'Cannot auto-format partially staged file: %s\nFormat it and stage the intended changes before committing.\n' "$file" >&2
    exit 1
  fi
  files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM -z)

for file in "${files[@]}"; do
  swift format -i -- "$file"
  git add -- "$file"
done
